# =========================================================================
# Пример переменных окружения.
# Скопируйте в app/core/config/envs/.env.<ENV> (.env.dev / .env.prod / .env.test)
# и заполните реальными значениями. Секретные .env.* файлы в git не попадают
# (см. .gitignore) — только этот .example.
#
# Формат: APP_<SECTION>__<FIELD>
#   APP_   — env_prefix из Settings.model_config
#   __     — env_nested_delimiter (разделитель между секцией и полем)
#
# Секции соответствуют полям Settings: app -> AppConfig, db -> DatabaseConfig.
# =========================================================================

# --- Окружение (читается ДО pydantic, определяет какой .env/.yaml грузить) ---
ENV=dev

# --- app: AppConfig ---
APP_APP__TITLE=AppTitle
APP_APP__HOST=0.0.0.0
APP_APP__PORT=8000
APP_APP__DEBUG=false
APP_APP__LOG_LEVEL=INFO

# --- db: DatabaseConfig ---
# PASSWORD обязателен (нет дефолта в модели) — приложение не запустится без него.
# В проде храните его в docker/k8s secret или менеджере секретов, а не в .env.
APP_DB__USERNAME=postgres
APP_DB__PASSWORD=change-me
APP_DB__DATABASE=restik_db
APP_DB__HOST=localhost
APP_DB__PORT=5432
APP_DB__DRIVER=postgresql+asyncpg
APP_DB__ECHO=false

# --- jwt: JWTConfig ---
# SECRET_KEY обязателен, без дефолта. Для dev сгенерировать можно так:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# В проде — из менеджера секретов, никогда не коммитить реальное значение.
APP_JWT__SECRET_KEY=change-me-to-a-random-64-byte-string
APP_JWT__ALGORITHM=HS256
APP_JWT__ACCESS_TOKEN_EXPIRE_MINUTES=15
APP_JWT__REFRESH_TOKEN_EXPIRE_DAYS=30
